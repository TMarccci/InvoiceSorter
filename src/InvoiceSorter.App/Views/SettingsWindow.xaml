<Window x:Class="InvoiceSorter.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Beállítások" Height="760" Width="1000" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="{StaticResource PageBackground}">
    <Window.Resources>
        <!-- Menu entries on the left: icon + title + one-line hint. -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                            <Border x:Name="Marker" Width="3" CornerRadius="2" HorizontalAlignment="Left" Margin="0,10"
                                    Background="{StaticResource AccentBrush}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF2F7" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E0EAFF" />
                                <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="28" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style x:Key="NavTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1E293B" />
        </Style>
        <Style x:Key="NavHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource MutedText}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <!-- Page heading and the sub-sections inside a page. -->
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="PageIntro" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="SubTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="Section" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Buttons -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="CancelButton" Content="Mégse" IsCancel="True" Width="100" Margin="0,0,8,0" />
                    <Button x:Name="SaveButton" Content="Mentés" Style="{StaticResource PrimaryButton}" Click="Save_Click" MinWidth="100" />
                </StackPanel>
                <TextBlock x:Name="FooterText" Style="{StaticResource Muted}" VerticalAlignment="Center" Text="A módosítások a Mentés gombbal lépnek életbe." />
            </DockPanel>
        </Border>

        <!-- Menu -->
        <Border DockPanel.Dock="Left" Width="250" Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,1,0" Padding="10,14">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Beállítások" FontSize="18" FontWeight="SemiBold" Margin="10,0,0,12" />
                <ListBox x:Name="Nav" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource NavItem}"
                         SelectedIndex="0" SelectionChanged="Nav_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBoxItem x:Name="ConfigNavItem">
                        <DockPanel>
                            <TextBlock Text="&#xE968;" Style="{StaticResource NavIcon}" />
                            <StackPanel>
                                <TextBlock Text="Konfiguráció" Style="{StaticResource NavTitle}" />
                                <TextBlock Text="Helyi vagy központi, frissítések" Style="{StaticResource NavHint}" />
                            </StackPanel>
                        </DockPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <DockPanel>
                            <TextBlock Text="&#xE731;" Style="{StaticResource NavIcon}" />
                            <StackPanel>
                                <TextBlock Text="Vevő cégek" Style="{StaticResource NavTitle}" />
                                <TextBlock Text="Vevők neve és adószáma" Style="{StaticResource NavHint}" />
                            </StackPanel>
                        </DockPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <DockPanel>
                            <TextBlock Text="&#xE8C6;" Style="{StaticResource NavIcon}" />
                            <StackPanel>
                                <TextBlock Text="Szétbontás" Style="{StaticResource NavTitle}" />
                                <TextBlock Text="Üres oldalak, forgatás, összevonás" Style="{StaticResource NavHint}" />
                            </StackPanel>
                        </DockPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <DockPanel>
                            <TextBlock Text="&#xE8A5;" Style="{StaticResource NavIcon}" />
                            <StackPanel>
                                <TextBlock Text="Oldaltípusok" Style="{StaticResource NavTitle}" />
                                <TextBlock Text="Címek, mellékletek, nem számlák" Style="{StaticResource NavHint}" />
                            </StackPanel>
                        </DockPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <DockPanel>
                            <TextBlock Text="&#xE8D2;" Style="{StaticResource NavIcon}" />
                            <StackPanel>
                                <TextBlock Text="Windows OCR" Style="{StaticResource NavTitle}" />
                                <TextBlock Text="Nyelv, felbontás, tűrés" Style="{StaticResource NavHint}" />
                            </StackPanel>
                        </DockPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <DockPanel>
                            <TextBlock Text="&#xE945;" Style="{StaticResource NavIcon}" />
                            <StackPanel>
                                <TextBlock Text="Surya OCR" Style="{StaticResource NavTitle}" />
                                <TextBlock Text="MI-alapú újraolvasás" Style="{StaticResource NavHint}" />
                            </StackPanel>
                        </DockPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <DockPanel>
                            <TextBlock Text="&#xE821;" Style="{StaticResource NavIcon}" />
                            <StackPanel>
                                <TextBlock Text="Kibocsátók" Style="{StaticResource NavTitle}" />
                                <TextBlock Text="Névjavítás, adószám, ismert nevek" Style="{StaticResource NavHint}" />
                            </StackPanel>
                        </DockPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <DockPanel>
                            <TextBlock Text="&#xE9D2;" Style="{StaticResource NavIcon}" />
                            <StackPanel>
                                <TextBlock Text="Megbízhatóság" Style="{StaticResource NavTitle}" />
                                <TextBlock Text="Alacsony megbízhatóság küszöbe" Style="{StaticResource NavHint}" />
                            </StackPanel>
                        </DockPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <DockPanel>
                            <TextBlock Text="&#xE74E;" Style="{StaticResource NavIcon}" />
                            <StackPanel>
                                <TextBlock Text="Mentés" Style="{StaticResource NavTitle}" />
                                <TextBlock Text="Fájlnevek, hibás számlák mappája" Style="{StaticResource NavHint}" />
                            </StackPanel>
                        </DockPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Pages -->
        <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" Padding="24,18,24,8">
            <StackPanel MaxWidth="780" HorizontalAlignment="Left">
            <Border x:Name="CentralBanner" Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14" Visibility="Collapsed">
                <TextBlock TextWrapping="Wrap" Foreground="#3730A3"
                           Text="Központi konfiguráció: ezeket a beállításokat a szerver rendszergazdája kezeli a szerverkezelőben, itt csak megtekinthetők. Helyi szerkesztéshez válts 'Helyi konfiguráció'-ra a Konfiguráció oldalon." />
            </Border>
            <Grid x:Name="PagesGrid">

                <!-- 0: Configuration (local / central) -->
                <StackPanel Visibility="{Binding SelectedIndex, ElementName=Nav, Converter={StaticResource StepVis}, ConverterParameter=0}">
                    <TextBlock Text="Konfiguráció" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageIntro}"
                               Text="Honnan származzanak a sablonok és a beállítások: erről a gépről, vagy egy Invoice Sorter szerverről, ahol a rendszergazda egy helyen szerkeszti őket minden gép számára." />
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <RadioButton IsChecked="{Binding IsLocalMode}" GroupName="ConfigMode" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Helyi konfiguráció" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="A sablonokat és a beállításokat ezen a gépen tárolja és szerkeszted." />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton IsChecked="{Binding IsCentralMode}" GroupName="ConfigMode">
                                <StackPanel>
                                    <TextBlock Text="Központilag kezelt konfiguráció" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                                               Text="A sablonokat és a beállításokat a szerverről kapja, és automatikusan frissíti őket. A Surya OCR is a szerveren fut, sorban állással. Ha a szerver nem érhető el, a legutóbb letöltött konfigurációval dolgozik." />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Section}" Visibility="{Binding IsCentralMode, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Invoice Sorter szerver" Style="{StaticResource SubTitle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Szerver címe" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Column="1" Text="{Binding Settings.CentralServerUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                                         ToolTip="pl. http://szerver:8770 – a szerverkezelő mutatja (https://, ha a szervernek van tanúsítványa)" />
                                <TextBlock Grid.Row="1" Text="Kliens kulcs" Style="{StaticResource FieldLabel}" />
                                <PasswordBox x:Name="CentralKeyBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" PasswordChanged="CentralKey_Changed"
                                             ToolTip="A szerverkezelő 'Kapcsolódás' oldalán látható kliens kulcs" />
                            </Grid>
                            <DockPanel Margin="140,4,0,0">
                                <Button x:Name="TestCentralButton" DockPanel.Dock="Left" Content="Kapcsolat tesztelése" Click="TestCentral_Click" Margin="0,0,12,0" VerticalAlignment="Top" />
                                <TextBlock Text="{Binding CentralStatus}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="Frissítések" Style="{StaticResource SubTitle}" />
                            <CheckBox IsChecked="{Binding Settings.CheckForUpdates}">
                                <TextBlock TextWrapping="Wrap" Text="Indításkor nézze meg, van-e új verzió (GitHub), és jelezze a fejlécben" />
                            </CheckBox>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 1: Receiving companies -->
                <StackPanel Visibility="{Binding SelectedIndex, ElementName=Nav, Converter={StaticResource StepVis}, ConverterParameter=1}">
                    <TextBlock Text="Vevő cégek" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageIntro}"
                               Text="Minden számlán szerepelnie kell a vevő adószámának. Ha hiányzik vagy hibás, a számla a hibás számlák közé kerül. Ha több cég számláit szkenneled, vedd fel mindegyiket." />
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="Cégek" Style="{StaticResource SubTitle}" />
                            <DataGrid ItemsSource="{Binding Receivers}" AutoGenerateColumns="False" CanUserAddRows="True" HeadersVisibility="Column"
                                      MinHeight="120" GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Cégnév" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                    <DataGridTextColumn Header="Adószám" Binding="{Binding VatNumber, UpdateSourceTrigger=PropertyChanged}" Width="170" />
                                    <DataGridTemplateColumn Header="Ellenőrzés" Width="190" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding VatNumber, Converter={StaticResource VatCheck}}" VerticalAlignment="Center" Margin="6,0"
                                                           Foreground="{Binding VatNumber, Converter={StaticResource VatCheckBrush}}" FontWeight="SemiBold" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0"
                                       Text="Minden szkennelést egy céghez ellenőriz: ahhoz, amelyik a legtöbb oldalon szerepel (vagy amelyet a feldolgozás előtt kiválasztasz). Ha az oldalak többsége egy nem felvett cégnek szól, az ellenőrző képernyő felajánlja a felvételét." />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="Nyugták" Style="{StaticResource SubTitle}" />
                            <CheckBox IsChecked="{Binding Settings.AcceptTaxNumberCore}">
                                <TextBlock TextWrapping="Wrap" Text="Elfogadja a vevő adószámának első 8 számjegyét (törzsszám), ha a teljes szám nincs kinyomtatva – nyugtán / egyszerűsített számlán ez elég" />
                            </CheckBox>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 2: Splitting -->
                <StackPanel Visibility="{Binding SelectedIndex, ElementName=Nav, Converter={StaticResource StepVis}, ConverterParameter=2}">
                    <TextBlock Text="Szétbontás" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageIntro}" Text="Hogyan készíti elő és csoportosítja számlákba a szkennelt oldalakat." />
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="Oldalak" Style="{StaticResource SubTitle}" />
                            <CheckBox IsChecked="{Binding Settings.RemoveBlankPages}" Margin="0,0,0,6">
                                <TextBlock TextWrapping="Wrap" Text="Üres oldalak elhagyása (egyoldalas dokumentumok hátoldala)" />
                            </CheckBox>
                            <StackPanel Orientation="Horizontal" Margin="28,0,0,10">
                                <TextBlock Text="Üres az oldal, ha a sötét képpontok aránya" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Text="{Binding BlankThresholdPercent}" Width="70" />
                                <TextBlock Text="% alatt van" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                            <CheckBox IsChecked="{Binding Settings.AutoRotate}">
                                <TextBlock TextWrapping="Wrap" Text="Az elforgatott / fejjel lefelé álló oldalak automatikus kiegyenesítése" />
                            </CheckBox>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="Számlákba csoportosítás" Style="{StaticResource SubTitle}" />
                            <CheckBox IsChecked="{Binding Settings.NewDocumentOnReceiverMatch}" Margin="0,0,0,6">
                                <TextBlock TextWrapping="Wrap" Text="Egy ismeretlen elrendezésű oldal, amelyen a vevő cég szerepel, új számlát kezd" />
                            </CheckBox>
                            <CheckBox IsChecked="{Binding Settings.MergeSameInvoiceNumber}">
                                <TextBlock TextWrapping="Wrap" Text="Az egymást követő, azonos sablonú és számlaszámú számlák összevonása (többoldalas számlák)" />
                            </CheckBox>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0"
                                       Text="Hogy mely oldalcímek kezdenek számlát, tartoznak az előzőhöz, vagy nem is számlák: lásd 'Oldaltípusok'." />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 3: Page types -->
                <StackPanel Visibility="{Binding SelectedIndex, ElementName=Nav, Converter={StaticResource StepVis}, ConverterParameter=3}">
                    <TextBlock Text="Oldaltípusok" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageIntro}" Text="Szavak és címek, amelyek eldöntik, hol kezdődik egy számla, és mely oldalak tartoznak hozzá. Soronként egy; a kisebb OCR-hibákat elviseli." />
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="Számlacímek" Style="{StaticResource SubTitle}" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,6" Text="Az ilyen sort tartalmazó oldal új számlát kezd (ha egyik sablon sem ismeri fel)." />
                            <TextBox Text="{Binding TitleKeywords}" AcceptsReturn="True" Height="120" VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="Folytatólapok" Style="{StaticResource SubTitle}" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,6" Text="Az ilyet tartalmazó oldal soha nem kezd új számlát (pl. 'Folytatólap', a hőpapíros nyugták nyomtatott hátoldala)." />
                            <TextBox Text="{Binding ContinuationKeywords}" AcceptsReturn="True" Height="70" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12" />
                            <TextBlock Text="Mellékletcímek" FontWeight="SemiBold" Margin="0,0,0,2" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,6" Text="Az az oldal, amelynek teteje ilyen sorral kezdődik (pl. ÁSZF), az előző számlához tartozik." />
                            <TextBox Text="{Binding ContinuationTitles}" AcceptsReturn="True" Height="70" VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="Nem számlák" Style="{StaticResource SubTitle}" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,6"
                                       Text="Az ilyen című (és nem számlacímű) első oldalt az ellenőrzésnél megjelöli – a szállítólevél, kivonat, átutalás, számlamelléklet … általában az előző számlához tartozik: vond össze vagy zárd ki, illetve jelöld meg az 'Ez számla' gombbal." />
                            <TextBox Text="{Binding NonInvoiceKeywords}" AcceptsReturn="True" Height="140" VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 4: Windows OCR -->
                <StackPanel Visibility="{Binding SelectedIndex, ElementName=Nav, Converter={StaticResource StepVis}, ConverterParameter=4}">
                    <TextBlock Text="Windows OCR" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageIntro}" Text="Először a Windows beépített szövegfelismerése olvas be minden oldalt – gyors, ingyenes és internet nélkül működik." />
                    <Border Style="{StaticResource Section}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="OCR nyelve" Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding OcrLanguages}" SelectedItem="{Binding Settings.OcrLanguage}" Width="200" HorizontalAlignment="Left" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="1" Text="Felbontás (DPI)" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Settings.RenderDpi}" Width="80" HorizontalAlignment="Left" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="2" Text="OCR-hibatűrés (0–0,4)" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Settings.FuzzyTolerance}" Width="80" HorizontalAlignment="Left" />
                        </Grid>
                    </Border>
                    <Border Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="8" Padding="14,10">
                        <TextBlock TextWrapping="Wrap" Foreground="#3730A3"
                                   Text="Tipp: a jobb ékezetfelismeréshez telepítsd a magyar OCR-nyelvet – Windows Gépház › Idő és nyelv › Nyelv › Magyar hozzáadása ('Optikai karakterfelismerés'-sel). Utána itt válaszd a hu-HU-t." />
                    </Border>
                </StackPanel>

                <!-- 5: Surya OCR -->
                <StackPanel Visibility="{Binding SelectedIndex, ElementName=Nav, Converter={StaticResource StepVis}, ConverterParameter=5}">
                    <TextBlock Text="Surya OCR" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageIntro}"
                               Text="A Surya egy MI-alapú szövegfelismerő modell: a halvány és apró betűket sokkal jobban olvassa, mint a Windows OCR – felhőszolgáltatás és kredit nélkül. Futhat ezen a gépen (egyszeri telepítés, ~5 GB, videokártyával gyors) vagy az Invoice Sorter szerveren, amelyet minden gép közösen használ (sorban állással)." />
                    <Border Style="{StaticResource Section}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Surya használata" Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding SuryaModes}" SelectedValue="{Binding Settings.SuryaMode}"
                                      SelectedValuePath="Mode" DisplayMemberPath="Text" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="1" Text="Hol fut" Style="{StaticResource FieldLabel}" Visibility="{Binding ShowSuryaLocation, Converter={StaticResource BoolToVis}}" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,2,0,0" Visibility="{Binding ShowSuryaLocation, Converter={StaticResource BoolToVis}}">
                                <RadioButton Content="Ezen a gépen" IsChecked="{Binding SuryaLocal}" GroupName="SuryaLocation" Margin="0,0,24,0" />
                                <RadioButton Content="Szerveren" IsChecked="{Binding SuryaOnServer}" GroupName="SuryaLocation" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- This computer -->
                    <Border Style="{StaticResource Section}" Visibility="{Binding ShowSuryaLocalSection, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Ezen a gépen" Style="{StaticResource SubTitle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Python (nem kötelező)" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Column="1" Text="{Binding Settings.SuryaPython}" Margin="0,0,0,6"
                                         ToolTip="Egy surya-ocr-t tartalmazó környezet python.exe-je. Üresen hagyva a program saját környezetét használja (Surya telepítése)." />
                            </Grid>
                            <TextBlock Style="{StaticResource Muted}" FontSize="11.5" Margin="140,0,0,8"
                                       Text="Üresen hagyva a program saját környezetét használja. A 'Surya telepítése…' létrehozza (Python 3.10+ kell, 10–30 perc)." />
                            <Button Content="Surya telepítése…" Click="InstallSurya_Click" HorizontalAlignment="Left" Margin="140,0,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Surya server -->
                    <Border Style="{StaticResource Section}" Visibility="{Binding ShowSuryaServerSection, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Surya a szerveren" Style="{StaticResource SubTitle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Szerver címe" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Column="1" Text="{Binding Settings.SuryaServerUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                                         ToolTip="pl. http://szerver:8770 – a szerverkezelő mutatja (https://, ha a szervernek van tanúsítványa)" />
                                <TextBlock Grid.Row="1" Text="Kliens kulcs" Style="{StaticResource FieldLabel}" />
                                <PasswordBox x:Name="SuryaApiKeyBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" PasswordChanged="SuryaApiKey_Changed"
                                             ToolTip="A szerverkezelőben látható kliens kulcs. Ennek a felhasználónak a beállításaiban tárolódik." />
                                <TextBlock Grid.Row="2" Text="Időkorlát (mp)" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Settings.SuryaServerTimeoutSeconds}" Width="80" HorizontalAlignment="Left" Margin="0,0,0,6"
                                         ToolTip="Egy oldalra legfeljebb ennyit vár. A szerver egymás után olvassa az oldalakat, így több felhasználónál egy oldal sorban állhat." />
                            </Grid>
                            <TextBlock Style="{StaticResource Muted}" FontSize="11.5" Margin="140,2,0,0"
                                       Text="Szerver telepítése: töltsd le az InvoiceSorter-Server-Setup-*.exe telepítőt a kiadások oldaláról a (lehetőleg NVIDIA videokártyás) szervergépre. A bizonytalan számlák oldalképei erre a szerverre kerülnek." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Section}" Visibility="{Binding ShowSuryaCentralNote, Converter={StaticResource BoolToVis}}">
                        <TextBlock TextWrapping="Wrap" Text="{Binding SuryaCentralNote}" />
                    </Border>
                    <Border x:Name="SuryaTestSection" Style="{StaticResource Section}">
                        <StackPanel>
                            <DockPanel>
                                <Button x:Name="TestSuryaButton" DockPanel.Dock="Left" Content="Surya tesztelése" Click="TestSurya_Click" Margin="0,0,12,0" VerticalAlignment="Top" />
                                <TextBlock Text="{Binding SuryaStatus}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0"
                                       Text="Licenc: a Surya kódja GPL-3.0; a modellsúlyoknak saját licencük van (személyes / kutatási célra és kisebb cégeknek ingyenes – üzleti használat előtt nézd meg: github.com/datalab-to/surya)." />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 6: Issuers -->
                <StackPanel Visibility="{Binding SelectedIndex, ElementName=Nav, Converter={StaticResource StepVis}, ConverterParameter=6}">
                    <TextBlock Text="Kibocsátók" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageIntro}" Text="Hogyan tisztítja és egészíti ki az oldalról olvasott kibocsátóneveket." />
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="Névjavítás" Style="{StaticResource SubTitle}" />
                            <CheckBox IsChecked="{Binding Settings.RepairIssuerNames}">
                                <TextBlock TextWrapping="Wrap" Text="Az oldalról olvasott kibocsátónevek OCR-hibáinak javítása (å → á, Szolgáltat6 → Szolgáltató, Ktt → Kft. …)" />
                            </CheckBox>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="Cégnyilvántartás (adószám alapján)" Style="{StaticResource SubTitle}" />
                            <CheckBox IsChecked="{Binding Settings.LookupIssuerNames}" Margin="0,0,0,4">
                                <TextBlock TextWrapping="Wrap" Text="A kibocsátó nevének lekérdezése adószám alapján az EU VIES nyilvántartásából (internet)" />
                            </CheckBox>
                            <TextBlock Style="{StaticResource Muted}" Margin="28,0,0,0"
                                       Text="Csak a szállító 8 jegyű adószáma kerül elküldésre (nyilvános cégadat); a válaszokat a company-registry.json tárolja. A hivatalos név lecseréli a rosszul olvasott nevet (pl. az eladó bankja vagy a vevő). Az ismert kibocsátók listája elsőbbséget élvez." />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="Ismert kibocsátók" Style="{StaticResource SubTitle}" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,6"
                                       Text="Helyesen írt nevek, soronként egy – adószámmal is: 'Minta Szolgáltató Kft. | 12345676-2-41'. Az oldalról olvasott, ezekhez hasonló nevet erre cseréli. Az ellenőrzésnél kézzel javított neveket mentéskor automatikusan felveszi." />
                            <TextBox Text="{Binding KnownIssuers}" AcceptsReturn="True" Height="260" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 7: Trust score -->
                <StackPanel Visibility="{Binding SelectedIndex, ElementName=Nav, Converter={StaticResource StepVis}, ConverterParameter=7}">
                    <TextBlock Text="Megbízhatóság" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageIntro}"
                               Text="Minden számla 0–100 pontot kap: mennyire biztos a program a kibocsátóban, a számlaszámban, a vevő adószámában és az oldalak szétbontásában (85-től magas, 60–84 közepes, 60 alatt alacsony). Az okokat az ellenőrző képernyő és a jelentés sorolja fel." />
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Alacsony megbízhatóság e pontszám alatt:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Text="{Binding Settings.LowTrustThreshold}" Width="60" />
                            </StackPanel>
                            <CheckBox IsChecked="{Binding Settings.LowTrustIsError}">
                                <TextBlock TextWrapping="Wrap" Text="Az alacsony megbízhatóságú számlák hibásnak számítanak (mentés előtt ellenőrizni kell őket / a hibás számlák mappájába kerülnek)" />
                            </CheckBox>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 8: Output -->
                <StackPanel Visibility="{Binding SelectedIndex, ElementName=Nav, Converter={StaticResource StepVis}, ConverterParameter=8}">
                    <TextBlock Text="Mentés" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageIntro}" Text="Hogyan nevezze el a mentett számlákat, és hová kerüljenek a hibás számlák." />
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="Fájlnév mintája" Style="{StaticResource SubTitle}" />
                            <TextBox Text="{Binding Settings.FileNameTemplate}" FontFamily="Consolas" Margin="0,0,0,4" />
                            <TextBlock Style="{StaticResource Muted}"
                                       Text="Helyettesítők: {InvoiceNumber} (számlaszám) {Issuer} (kibocsátó) {Style} (sablon) {Number} (sorszám). A '.pdf' kiterjesztést automatikusan hozzáadja; a fájlnévben nem megengedett karakterek (pl. /) helyett '-' kerül." />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="Hibás számlák" Style="{StaticResource SubTitle}" />
                            <CheckBox IsChecked="{Binding Settings.SaveErrorDocuments}" Margin="0,0,0,8">
                                <TextBlock TextWrapping="Wrap" Text="A hibás számlák mentése egy almappába" />
                            </CheckBox>
                            <StackPanel Orientation="Horizontal" Margin="28,0,0,0">
                                <TextBlock Text="Almappa neve" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Text="{Binding Settings.ErrorFolderName}" Width="180" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
