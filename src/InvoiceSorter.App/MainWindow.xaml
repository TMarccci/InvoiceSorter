<Window x:Class="InvoiceSorter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:InvoiceSorter.App.Controls"
        Title="Invoice Sorter" Icon="/InvoiceSorter;component/Assets/invoicesorter.ico" Height="920" Width="1520" MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="Window_Drop"
        Background="{StaticResource PageBackground}">
    <DockPanel>

        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}" Padding="20,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <!-- New version on GitHub -->
                    <Button Click="Update_Click" Margin="0,0,12,0" Padding="10,4" Cursor="Hand"
                            Background="#6366F1" Foreground="White" BorderThickness="0"
                            ToolTip="A kiadások oldalának megnyitása (letöltés és telepítés)"
                            Visibility="{Binding AvailableUpdate, Converter={StaticResource NullToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding UpdateText}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <!-- Local / central configuration -->
                    <Border CornerRadius="10" Padding="9,3" Margin="0,0,12,0" VerticalAlignment="Center" ToolTip="Beállítások › Konfiguráció">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#334155" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCentral}" Value="True">
                                        <Setter Property="Background" Value="#4F46E5" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CentralError}" Value="True">
                                        <Setter Property="Background" Value="#B45309" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE977;" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCentral}" Value="True">
                                                <Setter Property="Text" Value="&#xE968;" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding CentralStatus}" Foreground="White" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Button Content="Sablonok…" Click="OpenStyles_Click" Margin="0,0,8,0" />
                    <Button Content="Beállítások…" Click="OpenSettings_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/InvoiceSorter;component/Assets/invoicesorter-256.png" Width="30" Height="30" Margin="0,0,10,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Invoice Sorter" FontSize="20" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                    <TextBlock Text="szétbontás · olvasás · ellenőrzés · átnevezés" Foreground="#94A3B8" Margin="14,0,0,0" VerticalAlignment="Center" />
                    <Border Background="#334155" CornerRadius="8" Padding="7,1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AppVersion, Mode=OneTime}" Foreground="#CBD5E1" FontSize="11" />
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Stepper -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1" Padding="20,10">
            <UniformGrid Rows="1" Columns="5">
                <UniformGrid.Resources>
                    <Style TargetType="Border" x:Key="StepDot">
                        <Setter Property="Width" Value="26" />
                        <Setter Property="Height" Value="26" />
                        <Setter Property="CornerRadius" Value="13" />
                        <Setter Property="Margin" Value="0,0,8,0" />
                    </Style>
                </UniformGrid.Resources>
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource StepDot}" Background="{Binding StepNumber, Converter={StaticResource StepBrush}, ConverterParameter=1}">
                        <TextBlock Text="1" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                    </Border>
                    <TextBlock Text="Forrásfájl kiválasztása" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource StepDot}" Background="{Binding StepNumber, Converter={StaticResource StepBrush}, ConverterParameter=2}">
                        <TextBlock Text="2" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                    </Border>
                    <TextBlock Text="Számlákra bontás" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource StepDot}" Background="{Binding StepNumber, Converter={StaticResource StepBrush}, ConverterParameter=3}">
                        <TextBlock Text="3" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                    </Border>
                    <TextBlock Text="Adatok olvasása és ellenőrzés" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource StepDot}" Background="{Binding StepNumber, Converter={StaticResource StepBrush}, ConverterParameter=4}">
                        <TextBlock Text="4" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                    </Border>
                    <TextBlock Text="Hibák ellenőrzése" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource StepDot}" Background="{Binding StepNumber, Converter={StaticResource StepBrush}, ConverterParameter=5}">
                        <TextBlock Text="5" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                    </Border>
                    <TextBlock Text="Mentés" VerticalAlignment="Center" />
                </StackPanel>
            </UniformGrid>
        </Border>

        <!-- Log panel -->
        <Expander DockPanel.Dock="Bottom" IsExpanded="{Binding IsLogExpanded}" Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Padding="12,4">
            <Expander.Header>
                <DockPanel>
                    <TextBlock Text="Napló" FontWeight="SemiBold" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding LastLogLine}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </DockPanel>
            </Expander.Header>
            <DockPanel Height="220">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,4,0,6">
                    <CheckBox Content="Részletes (hibakereső) üzenetek" IsChecked="{Binding ShowDebugLog}" Margin="0,0,16,0" />
                    <Button Content="Naplómappa megnyitása" Command="{Binding OpenLogFolderCommand}" Margin="0,0,8,0" />
                    <Button Content="Nézet törlése" Command="{Binding ClearLogCommand}" />
                </StackPanel>
                <ListBox x:Name="LogList" ItemsSource="{Binding LogView}" FontFamily="Consolas" FontSize="12"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="4,1" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="{Binding Level, Converter={StaticResource LogLevelBrush}}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Expander>

        <!-- Content -->
        <Grid Margin="16">

            <!-- STEP 1: source -->
            <Border Style="{StaticResource Card}" Visibility="{Binding StepNumber, Converter={StaticResource StepVis}, ConverterParameter=1}"
                    MaxWidth="820" VerticalAlignment="Center" Padding="32">
                <StackPanel>
                    <TextBlock Text="Válaszd ki a szkennelt PDF-et" Style="{StaticResource SectionTitle}" FontSize="22" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,20"
                               Text="Válaszd ki a dokumentumszkenner által készített nagy PDF-et (vagy húzd ide az ablakra). Az oldalakat a Windows beépített szövegfelismerése olvassa – internet, MI-szolgáltatás vagy kredit nem kell hozzá." />
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Tallózás…" Command="{Binding BrowseSourceCommand}" Margin="8,0,0,0" />
                        <TextBox Text="{Binding SourcePath, Mode=OneWay}" IsReadOnly="True" VerticalContentAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding SourceInfo}" Style="{StaticResource Muted}" Margin="0,0,0,14" />

                    <DockPanel Margin="0,0,0,20">
                        <TextBlock Text="Vevő cég" Style="{StaticResource FieldLabel}" DockPanel.Dock="Left" />
                        <Grid HorizontalAlignment="Left" MinWidth="320">
                            <ComboBox ItemsSource="{Binding ReceiverChoices}" SelectedItem="{Binding SelectedReceiver}"
                                      ToolTip="A cég, amelynek a szkennelt számlák szólnak. Az 'Automatikus felismerés' az oldalakon lévő adószámokból találja meg.">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="{Binding Name, Mode=OneWay, FallbackValue='Automatikus felismerés', TargetNullValue='Automatikus felismerés'}" />
                                            <Run Text="{Binding VatNumber, Mode=OneWay, FallbackValue='', TargetNullValue=''}" Foreground="{StaticResource MutedText}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <!-- Nothing chosen = automatic detection: say so instead of an empty box. -->
                            <TextBlock IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0,36,0" Foreground="{StaticResource MutedText}"
                                       Visibility="{Binding SelectedReceiver, Converter={StaticResource NullToVisInverted}}">
                                <Run Text="&#xE721;" FontFamily="{StaticResource IconFont}" /> <Run Text="Automatikus felismerés" />
                            </TextBlock>
                        </Grid>
                    </DockPanel>

                    <Border Background="#F8FAFC" CornerRadius="6" Padding="14" Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Mi történik ezután" Margin="0,0,0,6" />
                            <TextBlock Style="{StaticResource Muted}" Text="• Minden oldalt beolvas (OCR). Az üres oldalakat elhagyja, az elforgatott oldalakat kiegyenesíti." />
                            <TextBlock Style="{StaticResource Muted}" Text="• A sablonok alapján számlákra bontja az oldalakat (egy felismert első oldal új számlát kezd)." />
                            <TextBlock Style="{StaticResource Muted}" Text="• Kiolvassa a kibocsátót és a számlaszámot, és ellenőrzi a vevő adószámát." />
                            <TextBlock Style="{StaticResource Muted}" Text="• Te ellenőrzöd a hibás számlákat, majd kiválasztod, hová mentse az átnevezett PDF-eket." />
                            <TextBlock Margin="0,10,0,0">
                                <Run Text="{Binding Styles.Count, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" sablon van megadva. " />
                                <Hyperlink Click="OpenStyles_Click">Sablonok kezelése</Hyperlink>
                                <Run Text="·" />
                                <Hyperlink Click="OpenSettings_Click">Vevő cégek és beállítások</Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Button Content="Feldolgozás indítása  →" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" />
                </StackPanel>
            </Border>

            <!-- STEPS 2-3: processing -->
            <Grid Visibility="{Binding StepNumber, Converter={StaticResource StepVis}, ConverterParameter=2|3}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="4*" MinWidth="380" />
                </Grid.ColumnDefinitions>

                <!-- Live preview of the page being read -->
                <Border Style="{StaticResource Card}" Padding="14">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding PreviewDetail}" Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                            <TextBlock Text="{Binding PreviewTitle}" FontSize="16" FontWeight="SemiBold" />
                        </DockPanel>
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <WrapPanel.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="Width" Value="14" />
                                    <Setter Property="Height" Value="10" />
                                    <Setter Property="BorderThickness" Value="2" />
                                    <Setter Property="Margin" Value="0,0,5,0" />
                                </Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                    <Setter Property="Margin" Value="0,0,16,0" />
                                    <Setter Property="FontSize" Value="11" />
                                </Style>
                            </WrapPanel.Resources>
                            <Border BorderBrush="#60A5FA" BorderThickness="1" /><TextBlock Text="felismert szöveg" />
                            <Border BorderBrush="MediumPurple" /><TextBlock Text="azonosító terület" />
                            <Border BorderBrush="SeaGreen" /><TextBlock Text="kibocsátó" />
                            <Border BorderBrush="RoyalBlue" /><TextBlock Text="számlaszám" />
                            <Border BorderBrush="DarkOrange" /><TextBlock Text="vevő adószáma" />
                            <Border BorderBrush="Gray" /><TextBlock Text="címke" />
                            <Border BorderBrush="Red" /><TextBlock Text="nem olvasható" />
                        </WrapPanel>
                        <Grid>
                            <controls:PageViewer ImagePath="{Binding PreviewImage}" Overlays="{Binding PreviewOverlays}" FitWholePage="True" />
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Progress and what each page turned out to be -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Feldolgozás…" Style="{StaticResource SectionTitle}" FontSize="20" />
                            <TextBlock Text="{Binding SourceInfo}" Style="{StaticResource Muted}" Margin="0,0,0,14" />
                            <!-- Elapsed time and the estimate for the running step -->
                            <Border Background="#F1F5F9" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                        <TextBlock Text="HÁTRALÉVŐ IDŐ" Style="{StaticResource ActionGroupTitle}" HorizontalAlignment="Right" Margin="0" />
                                        <TextBlock Text="{Binding RemainingText, TargetNullValue='–', FallbackValue='–'}" FontSize="18" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right" />
                                    </StackPanel>
                                    <TextBlock Text="&#xE916;" FontFamily="{StaticResource IconFont}" FontSize="22" VerticalAlignment="Center"
                                               Foreground="#64748B" Margin="0,0,10,0" />
                                    <StackPanel>
                                        <TextBlock Text="ELTELT IDŐ" Style="{StaticResource ActionGroupTitle}" Margin="0" />
                                        <TextBlock Text="{Binding ElapsedText}" FontSize="18" FontWeight="SemiBold" FontFamily="Consolas" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <TextBlock Text="{Binding ProgressText}" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding QueueText}" Foreground="{StaticResource AccentDarkBrush}" FontWeight="SemiBold" Margin="0,0,0,6"
                                       Visibility="{Binding QueueText, Converter={StaticResource NullToVis}}"
                                       ToolTip="A szerver Surya OCR-je egyszerre egy oldalt olvas; a többi gép oldalai sorban állnak." />
                            <ProgressBar Height="10" Maximum="{Binding ProgressMax}" Value="{Binding ProgressValue}" Margin="0,0,0,10" />
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Content="Mégse" Command="{Binding CancelCommand}" />
                                <TextBlock Text="{Binding FeedSummary}" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,8"
                                       Text="A hiányos számlákat a program újraolvassa: nagyítva, a másik OCR-nyelvvel, sötétebben, nagyobb kontraszttal, fekete-fehéren és világosabban – amíg az adatok olvashatók nem lesznek." />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding ProcessingFeed}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="Padding" Value="4,2" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Fill="{Binding Color}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Page}" Width="52" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Text}" Foreground="{Binding Color}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- STEP 4: review -->
            <Grid Visibility="{Binding StepNumber, Converter={StaticResource StepVis}, ConverterParameter=4}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,10">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Tovább a mentéshez  →" Command="{Binding GoToSaveCommand}" Style="{StaticResource PrimaryButton}" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock VerticalAlignment="Center" FontSize="14">
                                <Run Text="{Binding TotalCount, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" számla  ·  " />
                                <Run Text="{Binding OkCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="#16A34A" /><Run Text=" rendben  ·  " />
                                <Run Text="{Binding ErrorCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="#DC2626" /><Run Text=" hibás  ·  " />
                                <Run Text="{Binding ExcludedCount, Mode=OneWay}" Foreground="#6B7280" /><Run Text=" kizárva  ·  " Foreground="#6B7280" />
                                <Run Text="{Binding EditedCount, Mode=OneWay}" Foreground="#B45309" /><Run Text=" kézzel módosítva  ·  " Foreground="#B45309" />
                                <Run Text="{Binding PageCount, Mode=OneWay}" /><Run Text=" oldal (" /><Run Text="{Binding BlankCount, Mode=OneWay}" /><Run Text=" üres)" />
                            </TextBlock>
                            <Border Background="#F1F5F9" CornerRadius="10" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center"
                                    ToolTip="{Binding ProcessingTimeDetails}" Visibility="{Binding ProcessingTimeText, Converter={StaticResource NullToVis}}">
                                <TextBlock>
                                    <Run Text="&#xE916;" FontFamily="{StaticResource IconFont}" /> <Run Text="{Binding ProcessingTimeText, Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>
                            </Border>
                            <CheckBox Content="Csak hibások" IsChecked="{Binding ShowErrorsOnly}" Margin="24,0,12,0" VerticalAlignment="Center" />
                            <CheckBox IsChecked="{Binding ShowLowTrustOnly}" Margin="0,0,12,0" VerticalAlignment="Center"
                                      ToolTip="A Beállításokban megadott küszöb alatti megbízhatóságú számlák – hiba nélkül is érdemes ellenőrizni őket">
                                <TextBlock>
                                    <Run Text="Csak alacsony pontszám (" /><Run Text="{Binding LowTrustCount, Mode=OneWay}" Foreground="#DC2626" FontWeight="SemiBold" /><Run Text=")" />
                                </TextBlock>
                            </CheckBox>
                            <Button Content="Következő hiba" Command="{Binding NextErrorCommand}" Margin="0,0,8,0" />
                            <Button Content="Újrafelismerés" Command="{Binding RerunDetectionCommand}"
                                    ToolTip="Újra szétbontja és beolvassa a jelenlegi sablonokkal (a meglévő OCR-eredményekből; a kézi módosítások elvesznek)" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Receiving company of this scan (+ warning when most invoices are addressed to an unknown company) -->
                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                    <DockPanel>
                        <Grid DockPanel.Dock="Right" MinWidth="280">
                            <ComboBox ItemsSource="{Binding ReceiverChoices}" SelectedItem="{Binding JobReceiver}"
                                      ToolTip="A vevő adószámát egy másik vevő céghez ellenőrzi (minden számlát újraellenőriz)">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="{Binding Name, Mode=OneWay, FallbackValue='Bármelyik beállított cég', TargetNullValue='Bármelyik beállított cég'}" />
                                            <Run Text="{Binding VatNumber, Mode=OneWay, FallbackValue='', TargetNullValue=''}" Foreground="{StaticResource MutedText}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="Bármelyik beállított cég" IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0,36,0"
                                       Foreground="{StaticResource MutedText}" Visibility="{Binding JobReceiver, Converter={StaticResource NullToVisInverted}}" />
                        </Grid>
                        <TextBlock Text="{Binding ReceiverText}" VerticalAlignment="Center" Margin="4,0,12,0" />
                    </DockPanel>
                    <Border Background="#FFFBEB" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,8,0,0"
                            Visibility="{Binding SuggestedReceiver, Converter={StaticResource NullToVis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Felvétel vevő cégként és újraellenőrzés" Command="{Binding AddSuggestedReceiverCommand}" Margin="12,0,0,0" />
                            <TextBlock Text="{Binding SuggestionText}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#92400E" />
                        </DockPanel>
                    </Border>
                </StackPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*" MinWidth="380" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="6*" MinWidth="420" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}" Padding="0">
                        <DataGrid x:Name="DocumentsGrid" ItemsSource="{Binding DocumentsView}" SelectedItem="{Binding SelectedDocument}"
                                  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  SelectionMode="Single" CanUserAddRows="False" BorderThickness="0" RowHeight="30"
                                  EnableRowVirtualization="True">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Style.Triggers>
                                        <!-- Invoices changed by hand are highlighted; excluded ones are dimmed. -->
                                        <!-- Read by the generic fallback style: worth a glance. -->
                                        <DataTrigger Binding="{Binding IsGeneric}" Value="True">
                                            <Setter Property="Background" Value="#EEF2FF" />
                                            <Setter Property="ToolTip" Value="Egyik sablon sem illeszkedett – az általános szabályokkal olvasva. Ellenőrizd a kibocsátót és a számlaszámot." />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsManuallyEdited}" Value="True">
                                            <Setter Property="Background" Value="#FEF3C7" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Excluded}" Value="True">
                                            <Setter Property="Opacity" Value="0.5" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="28">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Ellipse Width="10" Height="10" Fill="{Binding StatusText, Converter={StaticResource StatusBrush}}" ToolTip="{Binding StatusText}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="✎" Width="32">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="✎" Foreground="#B45309" FontWeight="Bold" HorizontalAlignment="Center" ToolTip="{Binding EditsText}"
                                                       Visibility="{Binding IsManuallyEdited, Converter={StaticResource BoolToVis}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="40" />
                                <DataGridTextColumn Header="Oldalak" Binding="{Binding PageRange}" Width="70" />
                                <DataGridTextColumn Header="Sablon" Binding="{Binding StyleName}" Width="120" />
                                <DataGridTextColumn Header="Kibocsátó" Binding="{Binding Issuer}" Width="160" />
                                <DataGridTextColumn Header="Számlaszám" Binding="{Binding InvoiceNumber}" Width="130" />
                                <DataGridTextColumn Header="Vevő adószáma" Binding="{Binding VatText}" Width="130" />
                                <DataGridTemplateColumn Header="Pont" Width="70" SortMemberPath="Trust">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Trust, Converter={StaticResource TrustBrush}}" CornerRadius="8" Padding="6,0" HorizontalAlignment="Center"
                                                    ToolTip="{Binding TrustReasonsBullets}">
                                                <TextBlock Text="{Binding Trust}" Foreground="White" FontWeight="SemiBold" FontSize="11" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Problémák" Binding="{Binding ErrorsText}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#DC2626" />
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            <Setter Property="ToolTip" Value="{Binding ErrorsText}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

                    <!-- Detail panel -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                        <Grid>
                            <TextBlock Text="Válassz egy számlát a bal oldali listából." Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding SelectedDocument, Converter={StaticResource NullToVisInverted}}" />
                            <Grid DataContext="{Binding SelectedDocument}" Visibility="{Binding Converter={StaticResource NullToVis}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8">
                                    <Run Text="Számla #" /><Run Text="{Binding Number, Mode=OneWay}" />
                                    <Run Text="  ·  oldalak: " FontWeight="Normal" Foreground="{StaticResource MutedText}" /><Run Text="{Binding PageRange, Mode=OneWay}" FontWeight="Normal" Foreground="{StaticResource MutedText}" />
                                </TextBlock>

                                <!-- Problems -->
                                <Border Grid.Row="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,10"
                                        Background="{Binding HasErrors, Converter={StaticResource ErrorBackground}}"
                                        BorderBrush="{Binding HasErrors, Converter={StaticResource ErrorBrush}}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="✔  Nincs probléma – menthető" Foreground="#16A34A" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatusText}" Value="Rendben">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="⊘  Kizárva – ez a számla nem kerül mentésre" Foreground="#6B7280" FontWeight="SemiBold"
                                                   Visibility="{Binding Excluded, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Foreground="#B45309" Margin="0,4,0,0" TextWrapping="Wrap"
                                                   Visibility="{Binding IsManuallyEdited, Converter={StaticResource BoolToVis}}">
                                            <Run Text="✎  Kézzel módosítva:" FontWeight="SemiBold" /> <Run Text="{Binding EditsText, Mode=OneWay}" />
                                        </TextBlock>
                                        <ItemsControl ItemsSource="{Binding Errors}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding StringFormat='✖  {0}'}" Foreground="#B91C1C" TextWrapping="Wrap" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Fields -->
                                <Grid Grid.Row="2" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Sablon" Style="{StaticResource FieldLabel}" />
                                    <DockPanel Grid.Column="1" Margin="0,0,0,6">
                                        <ComboBox x:Name="StyleCombo" ItemsSource="{Binding DataContext.StyleChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding Style, Mode=OneWay}" SelectionChanged="StyleCombo_SelectionChanged">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name, FallbackValue='(nincs sablon)', TargetNullValue='(nincs sablon)'}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </DockPanel>

                                    <TextBlock Grid.Row="1" Text="Kibocsátó" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Issuer, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />
                                    <!-- Other issuer names the OCR readings also show: click to take one over -->
                                    <ItemsControl Grid.Row="2" Grid.Column="1" ItemsSource="{Binding DataContext.IssuerSuggestions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  Margin="0,-2,0,6" Visibility="{Binding DataContext.IssuerSuggestions.Count, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ZeroToVisInverted}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource SuggestionChip}" Content="{Binding Value}" Tag="issuer" Click="Suggestion_Click"
                                                        ToolTip="{Binding Source, StringFormat='Forrás: {0} – kattints az átvételhez'}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Grid.Row="3" Text="Számlaszám" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding InvoiceNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />
                                    <!-- Other invoice numbers the OCR readings also show: click to take one over -->
                                    <ItemsControl Grid.Row="4" Grid.Column="1" ItemsSource="{Binding DataContext.NumberSuggestions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  Margin="0,-2,0,6" Visibility="{Binding DataContext.NumberSuggestions.Count, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ZeroToVisInverted}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource SuggestionChip}" Content="{Binding Value}" Tag="number" Click="Suggestion_Click"
                                                        ToolTip="{Binding Source, StringFormat='Forrás: {0} – kattints az átvételhez'}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Grid.Row="5" Text="Vevő adószáma" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Vat.Message}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,6" />

                                    <TextBlock Grid.Row="6" Text="Fájlnév" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding DataContext.ProposedFileName, RelativeSource={RelativeSource AncestorType=Window}}"
                                               FontFamily="Consolas" VerticalAlignment="Center" TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="7" Text="Megbízhatóság" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,6,12,0" />
                                    <DockPanel Grid.Row="7" Grid.Column="1" Margin="0,6,0,0">
                                        <Border DockPanel.Dock="Left" Background="{Binding Trust, Converter={StaticResource TrustBrush}}" CornerRadius="10" Padding="10,2"
                                                VerticalAlignment="Top" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding TrustText}" Foreground="White" FontWeight="SemiBold" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Nincs levonás" Style="{StaticResource Muted}"
                                                       Visibility="{Binding TrustReasons.Count, Converter={StaticResource ZeroToVis}}" />
                                            <ItemsControl ItemsSource="{Binding TrustReasons}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <BulletDecorator Margin="0,0,0,1">
                                                            <BulletDecorator.Bullet>
                                                                <Ellipse Width="5" Height="5" Fill="#94A3B8" Margin="2,0,8,0" VerticalAlignment="Center" />
                                                            </BulletDecorator.Bullet>
                                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#475569" />
                                                        </BulletDecorator>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>

                                <!-- Actions: pages · invoice · export -->
                                <WrapPanel Grid.Row="3" Margin="0,2,0,6">
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock Text="OLDALAK" Style="{StaticResource ActionGroupTitle}" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource ActionButton}" Tag="&#xE8C6;" Content="Szétvágás itt"
                                                    Command="{Binding DataContext.SplitHereCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    ToolTip="A kijelölt oldal és az utána következők új számlát alkotnak" />
                                            <Button Style="{StaticResource ActionButton}" Tag="&#xE74A;" Content="Oldal fel"
                                                    Command="{Binding DataContext.MovePageUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    ToolTip="A kijelölt oldal eggyel előrébb kerül (a bélyegképek húzásával is megy)" />
                                            <Button Style="{StaticResource ActionButton}" Tag="&#xE74B;" Content="Oldal le"
                                                    Command="{Binding DataContext.MovePageDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    ToolTip="A kijelölt oldal eggyel hátrébb kerül (a bélyegképek húzásával is megy)" />
                                            <Button Style="{StaticResource ActionButton}" Tag="&#xE8E4;" Content="OCR-szöveg" Click="OcrText_Click"
                                                    ToolTip="A kijelölt oldalról kiolvasott teljes szöveg (minden olvasat: normál, újraolvasások, Surya)" />
                                            <Button Style="{StaticResource ActionButton}" Tag="&#xE7A7;" Content="Forgatás balra"
                                                    Command="{Binding DataContext.RotateLeftCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    ToolTip="A kijelölt oldal 90°-kal balra fordul – újraolvassa, és elforgatva menti" />
                                            <Button Style="{StaticResource ActionButton}" Tag="&#xE7AD;" Content="Forgatás jobbra"
                                                    Command="{Binding DataContext.RotateRightCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    ToolTip="A kijelölt oldal 90°-kal jobbra fordul – újraolvassa, és elforgatva menti" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock Text="SZÁMLA" Style="{StaticResource ActionGroupTitle}" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource ActionButton}" Tag="&#xE71B;" Content="Összevonás&#x0a;az előzővel"
                                                    Command="{Binding DataContext.MergeWithPreviousCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    ToolTip="Ennek a számlának az oldalait az előző számlához fűzi" />
                                            <Button Style="{StaticResource ActionButton}" Tag="&#xE8AB;" Content="Összevonás…" Click="MergeInto_Click"
                                                    ToolTip="Ennek a számlának az oldalait a szkennelés egy másik számlájához fűzi" />
                                            <Button Style="{StaticResource ActionButton}" Tag="&#xE72C;" Content="Újraolvasás"
                                                    Command="{Binding DataContext.RereadDocumentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    ToolTip="A kibocsátó, a számlaszám és az adószám újraolvasása a kiválasztott sablonnal" />
                                            <Button Style="{StaticResource ActionButton}" Tag="&#xE70F;" Content="Új sablon…" Click="CreateStyleFromPage_Click"
                                                    ToolTip="Új sablon készítése a kijelölt oldalból" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="MENTÉS" Style="{StaticResource ActionGroupTitle}" />
                                        <StackPanel Orientation="Horizontal">
                                            <ToggleButton Style="{StaticResource DangerAction}" Tag="&#xE733;" Content="Kizárás" IsChecked="{Binding Excluded}"
                                                          ToolTip="Ez a számla egyáltalán ne kerüljön mentésre (pl. kétszer beszkennelt lap, vagy nem számla)" />
                                            <ToggleButton Style="{StaticResource ToggleAction}" Tag="&#xE73E;" Content="Adószám&#x0a;elfogadva" IsChecked="{Binding VatApproved}"
                                                          ToolTip="Ellenőriztem: a számla elfogadható, bár a vevő adószámát nem sikerült automatikusan igazolni" />
                                            <ToggleButton Style="{StaticResource ToggleAction}" Tag="&#xE8A5;" Content="Ez számla" IsChecked="{Binding IsInvoiceConfirmed}"
                                                          Visibility="{Binding IsNonInvoice, Converter={StaticResource BoolToVis}}"
                                                          ToolTip="Az oldal szállítólevélnek / kivonatnak / mellékletnek tűnik, de valójában számla" />
                                            <ToggleButton Style="{StaticResource ToggleAction}" Tag="&#xE8C8;" Content="Duplikátum&#x0a;megtartása" IsChecked="{Binding DuplicateAccepted}"
                                                          Visibility="{Binding IsDuplicate, Converter={StaticResource BoolToVis}}"
                                                          ToolTip="Ugyanaz a kibocsátó és számlaszám valóban kétszer szerepel: mindkettő mentésre kerül (a második fájlnév _2 végződést kap)" />
                                        </StackPanel>
                                    </StackPanel>
                                </WrapPanel>

                                <!-- Pages of the invoice (left) and the selected page (right) -->
                                <Grid Grid.Row="4" Grid.RowSpan="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                <ListBox x:Name="PagesList" ItemsSource="{Binding Pages}" Margin="0,0,8,0" Padding="0" AllowDrop="True"
                                         PreviewMouseLeftButtonDown="PagesList_PreviewMouseLeftButtonDown" PreviewMouseMove="PagesList_PreviewMouseMove"
                                         DragOver="PagesList_DragOver" Drop="PagesList_Drop"
                                         ToolTip="Húzd az oldalakat a sorrend módosításához"
                                         SelectedItem="{Binding DataContext.SelectedPage, RelativeSource={RelativeSource AncestorType=Window}}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                            <Setter Property="Padding" Value="4" />
                                            <Setter Property="Margin" Value="0,0,0,2" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Width="64">
                                                <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Background="White">
                                                    <Image Source="{Binding ImagePath, Converter={StaticResource Thumbnail}}" Height="80" Stretch="Uniform" />
                                                </Border>
                                                <TextBlock HorizontalAlignment="Center" FontSize="11">
                                                    <Run Text="{Binding Number, Mode=OneWay}" /><Run Text=". oldal" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <DockPanel Grid.Column="1">
                                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"
                                               Text="A keretek mutatják, hol találta az adatokat. Nagyítás: Ctrl + egérgörgő. Az oldalak sorrendje a bélyegképek húzásával módosítható." />
                                    <controls:PageViewer ImagePath="{Binding DataContext.SelectedPageImage, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         Overlays="{Binding DataContext.PageOverlays, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </DockPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- STEP 5: save -->
            <Grid Visibility="{Binding StepNumber, Converter={StaticResource StepVis}, ConverterParameter=5}">
                <Border Style="{StaticResource Card}" MaxWidth="1000" Padding="28">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="A számlák mentése" Style="{StaticResource SectionTitle}" FontSize="22" />
                            <TextBlock Margin="0,0,0,16" FontSize="14">
                                <Run Text="{Binding OkCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="#16A34A" /><Run Text=" számla menthető, " />
                                <Run Text="{Binding ErrorCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="#DC2626" /><Run Text=" hibás, " />
                                <Run Text="{Binding ExcludedCount, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" kizárva." />
                            </TextBlock>

                            <TextBlock Text="Célmappa" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Content="Tallózás…" Command="{Binding BrowseOutputCommand}" Margin="8,0,0,0" />
                                <TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                            </DockPanel>
                            <CheckBox IsChecked="{Binding Settings.SaveErrorDocuments}" Margin="0,0,0,4">
                                <TextBlock>
                                    <Run Text="A hibás számlákat is mentse ebbe az almappába:" /> <Run Text="{Binding Settings.ErrorFolderName, Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>
                            </CheckBox>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,16">
                                <Run Text="A fájlnevek mintája:" /> <Run Text="{Binding Settings.FileNameTemplate, Mode=OneWay}" FontFamily="Consolas" /><Run Text=".pdf – meglévő fájlt soha nem ír felül (sorszámot fűz hozzá). A számlák mellé CSV-jelentés és a feldolgozás naplója is kerül." />
                            </TextBlock>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Content="←  Vissza az ellenőrzéshez" Command="{Binding BackToReviewCommand}" Margin="0,0,8,0" />
                                <Button Content="Számlák mentése" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
                                <Button Content="Mappa megnyitása" Command="{Binding OpenOutputFolderCommand}" Margin="0,0,8,0" />
                                <Button Content="Újabb fájl feldolgozása" Command="{Binding NewJobCommand}" />
                            </StackPanel>

                            <ProgressBar Height="8" Maximum="{Binding ProgressMax}" Value="{Binding ProgressValue}" Margin="0,0,0,8"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                            <Border Background="#F0FDF4" BorderBrush="#16A34A" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,12"
                                    Visibility="{Binding SaveSummary, Converter={StaticResource NullToVis}}">
                                <TextBlock Text="{Binding SaveSummary}" TextWrapping="Wrap" />
                            </Border>
                            <TextBlock Text="Előnézet" FontWeight="SemiBold" Margin="0,0,0,4" />
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding SavePreview}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" BorderThickness="1" BorderBrush="{StaticResource CardBorder}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="28">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Ellipse Width="10" Height="10" Fill="{Binding StatusText, Converter={StaticResource StatusBrush}}" ToolTip="{Binding StatusText}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="40" />
                                <DataGridTextColumn Header="Oldalak" Binding="{Binding Pages}" Width="80" />
                                <DataGridTextColumn Header="Fájl" Binding="{Binding FileName}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
