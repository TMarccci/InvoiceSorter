<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>InvoiceSorter</AssemblyName>
    <RootNamespace>InvoiceSorter.App</RootNamespace>
    <Product>Invoice Sorter</Product>
    <Version>1.2.0</Version>
    <Company>TMarccci</Company>
    <Authors>TMarccci</Authors>
    <Copyright>© TMarccci</Copyright>
    <Description>Szkennelt számlák szétbontása, olvasása és átnevezése</Description>
    <ApplicationIcon>..\..\assets\invoicesorter.ico</ApplicationIcon>
    <!-- WPF Fluent theme (ThemeMode) is marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\invoicesorter.ico" Link="Assets\invoicesorter.ico" />
    <Resource Include="..\..\assets\invoicesorter-256.png" Link="Assets\invoicesorter-256.png" />
    <Resource Include="..\..\assets\invoicesorter-server.ico" Link="Assets\invoicesorter-server.ico" />
    <Resource Include="..\..\assets\invoicesorter-server-256.png" Link="Assets\invoicesorter-server-256.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InvoiceSorter.Core\InvoiceSorter.Core.csproj" />
  </ItemGroup>

</Project>
