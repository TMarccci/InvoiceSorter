<Window x:Class="InvoiceSorter.ServerManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Invoice Sorter szerverkezelő" Icon="/InvoiceSorter;component/Assets/invoicesorter-server.ico"
        Height="780" Width="1180" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PageBackground}">
    <Window.Resources>
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                            <Border x:Name="Marker" Width="3" CornerRadius="2" HorizontalAlignment="Left" Margin="0,10"
                                    Background="{StaticResource AccentBrush}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF2F7" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E0E7FF" />
                                <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="28" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="PageIntro" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="SubTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Section" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="Key" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="Width" Value="170" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}" Padding="20,10">
            <DockPanel>
                <Border DockPanel.Dock="Right" CornerRadius="10" Padding="10,3" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#B91C1C" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Online}" Value="True">
                                    <Setter Property="Background" Value="#15803D" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Foreground="White" FontSize="12">
                        <Run Text="Szolgáltatás:" /> <Run Text="{Binding ServiceText, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                </Border>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/InvoiceSorter;component/Assets/invoicesorter-server-256.png" Width="30" Height="30" Margin="0,0,10,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Invoice Sorter szerver" FontSize="20" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                    <TextBlock Text="központi sablonok · beállítások · Surya-sor" Foreground="#94A3B8" Margin="14,0,0,0" VerticalAlignment="Center" />
                    <Border Background="#334155" CornerRadius="8" Padding="7,1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="VersionText" Foreground="#CBD5E1" FontSize="11" />
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Menu -->
        <Border DockPanel.Dock="Left" Width="230" Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,1,0" Padding="10,14">
            <ListBox x:Name="Nav" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource NavItem}" SelectedIndex="0"
                     SelectionChanged="Nav_SelectionChanged">
                <ListBoxItem>
                    <DockPanel><TextBlock Text="&#xE80F;" Style="{StaticResource NavIcon}" /><TextBlock Text="Áttekintés" FontWeight="SemiBold" /></DockPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <DockPanel><TextBlock Text="&#xE8A5;" Style="{StaticResource NavIcon}" /><TextBlock Text="Központi konfiguráció" FontWeight="SemiBold" /></DockPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <DockPanel><TextBlock Text="&#xE8FD;" Style="{StaticResource NavIcon}" /><TextBlock Text="Surya-sor" FontWeight="SemiBold" /></DockPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <DockPanel><TextBlock Text="&#xE713;" Style="{StaticResource NavIcon}" /><TextBlock Text="Szerver beállításai" FontWeight="SemiBold" /></DockPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <DockPanel><TextBlock Text="&#xE9F9;" Style="{StaticResource NavIcon}" /><TextBlock Text="Napló" FontWeight="SemiBold" /></DockPanel>
                </ListBoxItem>
            </ListBox>
        </Border>

        <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" Padding="24,18,24,8">
            <Grid MaxWidth="900" HorizontalAlignment="Left">

                <!-- 0: Overview -->
                <StackPanel Visibility="{Binding SelectedIndex, ElementName=Nav, Converter={StaticResource StepVis}, ConverterParameter=0}">
                    <TextBlock Text="Áttekintés" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageIntro}"
                               Text="A szerver Windows-szolgáltatásként fut. A kliensek innen kapják a sablonokat és a beállításokat, és ide küldik a Surya OCR-rel olvasandó oldalakat." />
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="Szolgáltatás" Style="{StaticResource SubTitle}" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Állapot" Style="{StaticResource Key}" />
                                <TextBlock Text="{Binding ServiceText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Surya OCR" Style="{StaticResource Key}" />
                                <TextBlock Text="{Binding SuryaText}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="600" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Sor" Style="{StaticResource Key}" />
                                <TextBlock Text="{Binding QueueText}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Konfiguráció" Style="{StaticResource Key}" />
                                <TextBlock Text="{Binding CentralText}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="600" />
                            </StackPanel>
                            <TextBlock Text="{Binding ApiError}" Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Visibility="{Binding ApiError, Converter={StaticResource NullToVis}}" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Content="Indítás" Click="StartService_Click" Margin="0,0,8,0" MinWidth="100"
                                        IsEnabled="{Binding ServiceStopped}" />
                                <Button Content="Leállítás" Click="StopService_Click" Margin="0,0,8,0" MinWidth="100"
                                        IsEnabled="{Binding ServiceRunning}" />
                                <Button Content="Újraindítás" Click="RestartService_Click" MinWidth="100"
                                        IsEnabled="{Binding ServiceInstalled}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="Kapcsolódás a kliensekből" Style="{StaticResource SubTitle}" />
                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                                       Text="A klienseken: Beállítások › Konfiguráció › Központilag kezelt konfiguráció, majd add meg a szerver címét és a kliens kulcsot." />
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Szerver címe" Style="{StaticResource Key}" VerticalAlignment="Top" />
                                <ItemsControl ItemsSource="{Binding Addresses}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBox Text="{Binding Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" Width="320" />
                                                <Button Content="Másolás" Click="CopyText_Click" Tag="{Binding}" Margin="6,0,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="Kliens kulcs" Style="{StaticResource Key}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="ClientKeyText" Text="{Binding Config.ClientKey, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" Width="320" />
                                    <Button Content="Másolás" Click="CopyClientKey_Click" Margin="6,0,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 1: Central configuration -->
                <StackPanel Visibility="{Binding SelectedIndex, ElementName=Nav, Converter={StaticResource StepVis}, ConverterParameter=1}">
                    <TextBlock Text="Központi konfiguráció" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageIntro}"
                               Text="A központi módban futó kliensek ezeket a sablonokat és beállításokat használják. Mentés után legfeljebb 5 percen belül (és minden feldolgozás előtt) automatikusan megkapják." />
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="{Binding CentralText}" TextWrapping="Wrap" Margin="0,0,0,12" />
                            <WrapPanel>
                                <Button Style="{StaticResource ActionButton}" Tag="&#xE8A5;" Content="Sablonok szerkesztése" Click="EditStyles_Click" Margin="0,0,10,10" Width="200" />
                                <Button Style="{StaticResource ActionButton}" Tag="&#xE713;" Content="Beállítások szerkesztése" Click="EditSettings_Click" Margin="0,0,10,10" Width="200" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="Átvétel és mentés" Style="{StaticResource SubTitle}" />
                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                                       Text="Egy kliens helyi konfigurációját (styles.json, settings.json – a kliensen: %APPDATA%\InvoiceSorter) feltöltheted központinak. A gépfüggő beállítások (mappák, Surya helye) nem kerülnek át." />
                            <WrapPanel>
                                <Button Content="Helyi konfiguráció importálása…" Click="Import_Click" Margin="0,0,8,8" />
                                <Button Content="Exportálás fájlba…" Click="Export_Click" Margin="0,0,8,8" />
                                <Button Content="Biztonsági mentések mappája" Click="OpenBackups_Click" Margin="0,0,8,8" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 2: Queue -->
                <StackPanel Visibility="{Binding SelectedIndex, ElementName=Nav, Converter={StaticResource StepVis}, ConverterParameter=2}">
                    <TextBlock Text="Surya-sor" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageIntro}"
                               Text="A Surya egyszerre egy oldalt olvas; a többi érkezési sorrendben vár. A kliensek oldalanként küldenek, így több gép oldalai felváltva kerülnek sorra. A befejezett feladatok 10 perc után eltűnnek." />
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="{Binding QueueText}" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <DataGrid ItemsSource="{Binding Jobs}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal" MinHeight="260" MaxHeight="520">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Állapot" Binding="{Binding StatusText}" Width="110" />
                                    <DataGridTextColumn Header="Kliens" Binding="{Binding Client}" Width="*" />
                                    <DataGridTextColumn Header="Beérkezett" Binding="{Binding QueuedAt, StringFormat=HH:mm:ss}" Width="90" />
                                    <DataGridTextColumn Header="Indult" Binding="{Binding StartedAt, StringFormat=HH:mm:ss}" Width="90" />
                                    <DataGridTextColumn Header="Kész" Binding="{Binding FinishedAt, StringFormat=HH:mm:ss}" Width="90" />
                                    <DataGridTextColumn Header="Hiba" Binding="{Binding Error}" Width="2*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Surya újraindítása" Click="RestartSurya_Click" Margin="0,0,8,0"
                                        ToolTip="Leállítja és újraindítja a Surya OCR-t (pl. telepítés után). A futó oldal sikertelen lesz, a kliens Windows OCR-rel folytatja." />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 3: Server settings -->
                <StackPanel Visibility="{Binding SelectedIndex, ElementName=Nav, Converter={StaticResource StepVis}, ConverterParameter=3}">
                    <TextBlock Text="Szerver beállításai" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageIntro}" TextWrapping="Wrap">
                        <Run Text="A server.json tartalma. A módosítások a szolgáltatás újraindítása után lépnek életbe. Adatmappa:" />
                        <Run Text="{Binding DataDir, Mode=OneWay}" FontFamily="Consolas" />
                    </TextBlock>
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="Hálózat" Style="{StaticResource SubTitle}" />
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="Port" Style="{StaticResource Key}" />
                                <TextBox Text="{Binding Edit.Port}" Width="90" HorizontalAlignment="Left" />
                            </DockPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="Figyelt cím" Style="{StaticResource Key}" />
                                <TextBox Text="{Binding Edit.BindAddress}" Width="160" HorizontalAlignment="Left"
                                         ToolTip="0.0.0.0 = minden hálózati kártya; 127.0.0.1 = csak erről a gépről érhető el" />
                            </DockPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="HTTPS tanúsítvány (.pfx)" Style="{StaticResource Key}" />
                                <Button DockPanel.Dock="Right" Content="Tallózás…" Click="BrowseCertificate_Click" Margin="6,0,0,0" />
                                <TextBox Text="{Binding Edit.CertificatePath}" ToolTip="Nem kötelező. Üresen hagyva HTTP-n fut (belső hálózatra elég)." />
                            </DockPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="Tanúsítvány jelszava" Style="{StaticResource Key}" />
                                <PasswordBox x:Name="CertPasswordBox" PasswordChanged="CertPassword_Changed" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="Kulcsok" Style="{StaticResource SubTitle}" />
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="Kliens kulcs" Style="{StaticResource Key}" />
                                <Button DockPanel.Dock="Right" Content="Új kulcs" Click="NewClientKey_Click" Margin="6,0,0,0"
                                        ToolTip="Új kulcsot készít – mentés és újraindítás után a régi kulccsal a kliensek nem kapcsolódhatnak" />
                                <TextBox Text="{Binding Edit.ClientKey}" FontFamily="Consolas" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11.5" Margin="170,0,0,0"
                                       Text="Az adminisztrátori kulcsot (a konfiguráció módosításához) a szerverkezelő a server.json-ból olvassa; a kliensekhez nem kell." />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="Surya OCR" Style="{StaticResource SubTitle}" />
                            <CheckBox IsChecked="{Binding Edit.SuryaEnabled}" Content="A Surya OCR fusson ezen a szerveren a kliensek számára" Margin="0,0,0,8" />
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="Python (nem kötelező)" Style="{StaticResource Key}" />
                                <TextBox Text="{Binding Edit.SuryaPython}" ToolTip="Üresen hagyva a szerver saját környezetét használja (adatmappa\surya\venv)" />
                            </DockPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="Sor hossza (oldal)" Style="{StaticResource Key}" />
                                <TextBox Text="{Binding Edit.MaxQueue}" Width="90" HorizontalAlignment="Left" />
                            </DockPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="Időkorlát oldalanként (perc)" Style="{StaticResource Key}" />
                                <TextBox Text="{Binding Edit.JobTimeoutMinutes}" Width="90" HorizontalAlignment="Left" />
                            </DockPanel>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="Legnagyobb oldalkép (MB)" Style="{StaticResource Key}" />
                                <TextBox Text="{Binding Edit.MaxImageMb}" Width="90" HorizontalAlignment="Left" />
                            </DockPanel>
                            <StackPanel Orientation="Horizontal" Margin="170,0,0,0">
                                <Button Content="Surya telepítése…" Click="InstallSurya_Click" Margin="0,0,8,0" />
                                <Button Content="Surya-mappa megnyitása" Click="OpenSuryaFolder_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button Content="Mentés és újraindítás" Style="{StaticResource PrimaryButton}" Click="SaveServer_Click" Margin="0,0,8,0" />
                        <Button Content="Elvetés" Click="RevertServer_Click" />
                    </StackPanel>
                </StackPanel>

                <!-- 4: Log -->
                <DockPanel Visibility="{Binding SelectedIndex, ElementName=Nav, Converter={StaticResource StepVis}, ConverterParameter=4}">
                    <TextBlock DockPanel.Dock="Top" Text="Napló" Style="{StaticResource PageTitle}" />
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,4,0,10">
                        <Button Content="Frissítés" Click="RefreshLog_Click" Margin="0,0,8,0" />
                        <Button Content="Naplómappa megnyitása" Click="OpenLogFolder_Click" />
                        <TextBlock x:Name="LogFileText" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                    <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12" Height="520" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                </DockPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
